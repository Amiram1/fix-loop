{
	"name": "fixloop",
	"version": "0.0.1",
	"description": "Triage and fix bugs reported as GitHub issues, using an agent that runs in GitHub Actions",
	"license": "MIT",
	"type": "module",
	"bin": {
		"fixloop": "dist/cli.js"
	},
	"main": "dist/action/index.js",
	"files": [
		"dist",
		"action.yml"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && npm run build:action",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"lint": "biome check . && eslint .",
		"build:action": "ncc build src/index.ts -o dist/action -m && find dist/action -name '*.d.ts' -delete",
		"lint:fix": "biome check --write . && eslint --fix .",
		"fixloop": "node dist/cli.js"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.19.1",
		"@vercel/ncc": "^0.45.0",
		"eslint": "^10.12.0",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.71.1",
		"vitest": "^2.0.0"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	}
}
